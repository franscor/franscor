{
  "name": "franscor",
  "version": "0.2.0",
  "description": "FRANSCOR — secure interoperability layer for AI agents (identity, discovery, delegation, signed evidence)",
  "license": "Apache-2.0",
  "author": "Lamstra Labs",
  "homepage": "https://franscor.com/sdk",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "franscor": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "interoperability",
    "protocol",
    "ed25519",
    "langchain",
    "mcp",
    "a2a"
  ],
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/core": "2.0.1",
    "@opentelemetry/sdk-trace-base": "2.0.1",
    "@types/node": "22.10.2",
    "typescript": "5.6.3"
  }
}
