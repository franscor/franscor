{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franscor.dev/fsp/0.2/passport-crl.json",
  "title": "FSP 0.2 passport revocation list",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fsp",
    "type",
    "hub_id",
    "serial",
    "issued_at",
    "revoked",
    "sig"
  ],
  "properties": {
    "fsp": {
      "const": "0.2"
    },
    "type": {
      "const": "passport-crl"
    },
    "hub_id": {
      "type": "string",
      "pattern": "^fsp:[0-9a-f]{32}$"
    },
    "serial": {
      "type": "integer",
      "minimum": 0
    },
    "issued_at": {
      "type": "integer"
    },
    "revoked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "passport_id",
          "agent_id",
          "revoked_at",
          "reason",
          "ban"
        ],
        "properties": {
          "passport_id": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "revoked_at": {
            "type": "integer"
          },
          "reason": {
            "type": "string",
            "maxLength": 200
          },
          "ban": {
            "type": "boolean"
          }
        }
      }
    },
    "sig": {
      "type": "string"
    }
  }
}
