{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://franscor.dev/fsp/0.2/passport.json",
  "title": "FSP 0.2 passport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fsp",
    "type",
    "passport_id",
    "hub_id",
    "hub_public_key",
    "agent_id",
    "org",
    "agent_public_key",
    "capabilities",
    "issued_at",
    "expires_at",
    "sig"
  ],
  "properties": {
    "fsp": {
      "const": "0.2"
    },
    "type": {
      "const": "passport"
    },
    "passport_id": {
      "type": "string",
      "pattern": "^pp_[0-9a-f]{32}$"
    },
    "hub_id": {
      "type": "string",
      "pattern": "^fsp:[0-9a-f]{32}$"
    },
    "hub_public_key": {
      "type": "string",
      "pattern": "^-----BEGIN PUBLIC KEY-----"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^fsp:[0-9a-f]{32}$"
    },
    "org": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{1,64}$"
    },
    "agent_public_key": {
      "type": "string",
      "pattern": "^-----BEGIN PUBLIC KEY-----"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "issued_at": {
      "type": "integer"
    },
    "expires_at": {
      "type": "integer"
    },
    "sig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
